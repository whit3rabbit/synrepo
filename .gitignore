# Rust
/target
**/*.rs.bk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
__MACOSX

# Hidden folders (ignore by default, whitelist needed ones)
.*
!.gitignore
!.github/

# synrepo Codex skill: a tracked copy of the generated Codex shim, kept in sync
# with AgentTool::Codex by the agent_shims doctrine tests and installable as a
# skill. Whitelist only this file; the rest of .agents/ stays ignored.
!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/synrepo/
.agents/skills/synrepo/*
!.agents/skills/synrepo/SKILL.md

# syntext
.syntext/

# Repomix
repomix-output.xml

# Local command output
/mcp_stderr.log
/test_output.txt
/.mcp.json
/artifacts/
/openspec/

/tmp/synrepo-context/
/tmp/synrepo-context-json/
synrepo-context/
/tmp/synrepo-export-test/
/tmp/synrepo-export-test2/
